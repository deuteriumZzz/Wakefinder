[Unit]
Description=Wakefinder — ETH backrun-арбитраж
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/wakefinder
EnvironmentFile=/opt/wakefinder/.env
# configs/eth-arb.toml — пример профиля, отредактируйте под свои
# pools/reference_pools перед боевым запуском (см. README "Конфиг-профили").
ExecStart=/opt/wakefinder/.venv/bin/wakefinder run configs/eth-arb.toml
Restart=always
RestartSec=5
User=wakefinder

[Install]
WantedBy=multi-user.target
