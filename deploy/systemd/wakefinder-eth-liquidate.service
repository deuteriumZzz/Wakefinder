[Unit]
Description=Wakefinder — ETH ликвидации на Aave V3
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/wakefinder
EnvironmentFile=/opt/wakefinder/.env
# configs/eth-liquidate.toml — требует предварительно профинансированный и
# approve-нутый кошелёк под LIQUIDATION_DEBT_ASSETS (не flash-loan based,
# см. README "Ликвидации на Aave V3"). ОТДЕЛЬНЫЙ кошелёк от остальных
# стратегий при общем ETH_PRIVATE_KEY.
ExecStart=/opt/wakefinder/.venv/bin/wakefinder run configs/eth-liquidate.toml
Restart=always
RestartSec=5
User=wakefinder

[Install]
WantedBy=multi-user.target
