[Unit]
Description=Wakefinder — Solana снайпинг новых пулов
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/wakefinder
EnvironmentFile=/opt/wakefinder/.env
# configs/solana-snipe.toml — пример профиля.
ExecStart=/opt/wakefinder/.venv/bin/wakefinder run configs/solana-snipe.toml
Restart=always
RestartSec=5
User=wakefinder

[Install]
WantedBy=multi-user.target
