[Unit]
Description=Wakefinder — Solana backrun-арбитраж
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/wakefinder
EnvironmentFile=/opt/wakefinder/.env
# configs/solana-arb.toml — пример профиля, отредактируйте под свои
# solana_pools перед боевым запуском.
ExecStart=/opt/wakefinder/.venv/bin/wakefinder run configs/solana-arb.toml
Restart=always
RestartSec=5
User=wakefinder

[Install]
WantedBy=multi-user.target
