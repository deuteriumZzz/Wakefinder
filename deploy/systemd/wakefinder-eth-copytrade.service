[Unit]
Description=Wakefinder — ETH копитрейдинг
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/wakefinder
EnvironmentFile=/opt/wakefinder/.env
# configs/eth-copytrade-conservative.toml — пример профиля, отредактируйте
# watched_wallets/token_allowlist. Альтернатива: eth-copytrade-fast-memecoin.toml
# (быстрее, ниже consensus — см. README).
ExecStart=/opt/wakefinder/.venv/bin/wakefinder run configs/eth-copytrade-conservative.toml
Restart=always
RestartSec=5
User=wakefinder

[Install]
WantedBy=multi-user.target
