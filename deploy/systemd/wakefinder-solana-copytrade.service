[Unit]
Description=Wakefinder — Solana копитрейдинг
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/wakefinder
EnvironmentFile=/opt/wakefinder/.env
# configs/solana-copytrade.toml — пример профиля, отредактируйте
# watched_wallets/token_allowlist перед боевым запуском.
ExecStart=/opt/wakefinder/.venv/bin/wakefinder run configs/solana-copytrade.toml
Restart=always
RestartSec=5
User=wakefinder

[Install]
WantedBy=multi-user.target
