# Ethereum
# Обязательны оба; у провайдеров несовместимые схемы путей WS<->HTTP, поэтому
# один URL никогда не выводится из другого. HTTP URL обязан поддерживать
# eth_getRawTransactionByHash.
ETH_RPC_WS_URL=wss://your-provider/ws
ETH_RPC_HTTP_URL=https://your-provider/http
# Отдельный горячий кошелёк ТОЛЬКО для этого бота — никогда не ваш основной
# кошелёк, держите баланс минимальным, регулярно выводите прибыль. Должен
# отличаться от ключа подписи ниже (бот отказывается стартовать, если они
# указывают на один адрес).
ETH_PRIVATE_KEY=0x...
# Ключ ТОЛЬКО для репутации у relay Flashbots — никогда не финансируется,
# никогда не тот же кошелёк, что ETH_PRIVATE_KEY выше.
FLASHBOTS_SIGNER_KEY=0x...
# Альтернатива голым ключам выше — шифрованный файл вместо plaintext, см.
# README "Безопасность". Ровно один источник на ключ (plaintext ИЛИ файл).
# python -m wakefinder.common.keystore <путь> — зашифровать интерактивно.
# ETH_PRIVATE_KEY_FILE=
# FLASHBOTS_SIGNER_KEY_FILE=
# SOLANA_PRIVATE_KEY_FILE=
# WALLET_KEY_PASSPHRASE=          # обязателен, если используется любой *_KEY_FILE выше

# Solana — опционально, только если запускаете этот путь.
# Отдельный горячий кошелёк ТОЛЬКО для Solana-бота — своё keyspace, физически
# не может совпадать с ETH-ключами. base58, не hex.
# SOLANA_RPC_WS_URL=wss://your-provider/ws
# SOLANA_RPC_HTTP_URL=https://your-provider/http
# SOLANA_PRIVATE_KEY=base58...
# Доп. WS-провайдеры через запятую — та же гонка за обнаружение, что и
# ETH_RPC_WS_URLS выше, см. README "Гонка RPC-провайдеров".
# SOLANA_RPC_WS_URLS=wss://second-provider/ws,wss://third-provider/ws
# JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1
# MAX_CAPITAL_PER_BUNDLE_SOL=0.5

# Список MEV-relay через запятую — бандл уходит параллельно во все (см.
# README "Мульти-relay отправка"). Дефолт — только Flashbots.
# ETH_RELAY_URLS=https://relay.flashbots.net
# API-ключи через запятую, ПОЗИЦИОННО к ETH_RELAY_URLS (не общий список —
# пустая позиция значит "для этого relay без авторизации", см. README
# "Мульти-relay отправка"). Пример: первому relay ключ, второму нет —
# "my-bloxroute-key," (пустая строка после запятой для второго).
# ETH_RELAY_API_KEYS=
#
# Прямая отправка нескольким билдерам (не только через Flashbots relay) —
# рынок билдинга блоков фрагментирован, бандл, отправленный ТОЛЬКО в
# Flashbots relay, физически не может попасть в блок, который строит другой
# билдер. Добавьте адреса builder RPC в ETH_RELAY_URLS через запятую — тот же
# механизм, что и обычные relay (eth_sendBundle — стандартный метод, см.
# README "Прямая отправка билдерам"). Большинство прямых builder RPC не
# требуют авторизации — оставляйте соответствующую позицию в
# ETH_RELAY_API_KEYS пустой. ПРОВЕРЬТЕ АКТУАЛЬНОСТЬ URL САМИ перед
# использованием (список builder'ов меняется) — источник:
# https://github.com/flashbots/dowg/blob/main/builder-registrations.json
# ETH_RELAY_URLS=https://relay.flashbots.net,https://mevshare-rpc.beaverbuild.org,https://rpc.titanbuilder.xyz,https://builder0x69.io,https://rsync-builder.xyz

# Дополнительные WS-провайдеры через запятую (сверх ETH_RPC_WS_URL) — гонка
# за первенство в обнаружении pending-tx, первый увидевший выигрывает,
# дубликаты от остальных отбрасываются. См. README "Гонка RPC-провайдеров".
# Пусто по умолчанию = гонка выключена, поведение как с одним провайдером.
# ETH_RPC_WS_URLS=wss://second-provider/ws,wss://third-provider/ws

# Dry-run: вся логика решений выполняется как обычно, но реальная отправка
# на блокчейн пропускается — см. README "Dry-run режим".
# DRY_RUN=false

# Контроль риска
MAX_GAS_GWEI=50
MAX_CAPITAL_PER_BUNDLE_ETH=0.05
# KILL_SWITCH_FILE=             # пусто = дефолт killswitch.py (абсолютный путь в домашней директории, единый на все 4 процесса)
# PROFIT_SHARE_BPS=9000         # % захваченной прибыли, предлагаемый как tip за включение (0-10000)

# Портфельный circuit breaker по просадке — см. README "Портфельный риск-контроль"
# MAX_DRAWDOWN_ETH=0.5
# MAX_DRAWDOWN_SOL=5.0
# DRAWDOWN_WINDOW_SECONDS=86400
# DRAWDOWN_CHECK_INTERVAL_SECONDS=300

# Лимит СУММАРНОЙ экспозиции по одному токену через РАЗНЫЕ стратегии
# (copytrade+snipe вместе, см. README "Лимит экспозиции по токену между
# стратегиями") — выключено по умолчанию (None), включайте осознанно.
# MAX_TOKEN_EXPOSURE_ETH=1.0
# MAX_TOKEN_EXPOSURE_SOL=10.0

# Столько подряд неудачных попыток оценить цену позиции (сбой
# getAmountsOut/quote — обычно rug/высохшая ликвидность) переводят её в
# состояние "зависшая" — см. README "Портфельный риск-контроль".
# STUCK_POSITION_THRESHOLD=5

# Поэтапный ввод капитала — см. README "Поэтапный ввод капитала (canary)"
# CANARY_START_FRACTION=1.0     # 1.0 = выключено (сразу полный размер)
# CANARY_RAMP_TRADES=20         # сколько included-сделок до выхода на 100%

# Корректировка размера копитрейд-входа по win rate кошелька — см. README
# COPYTRADE_SIZING_MIN_TRADES=5
# COPYTRADE_SIZING_MIN_MULTIPLIER=0.25
# COPYTRADE_SIZING_MAX_MULTIPLIER=1.5

# Авто-обнаружение доп. референсных пулов на других известных DEX — см. README
# ETH_AUTO_DISCOVER_REFERENCE_POOLS=false

# Минимальная ликвидность референсного пула — защита от манипуляции ценой
# на тонком пуле (в единицах token_in, см. ponytail-заметку в simulator.py)
# MIN_REFERENCE_LIQUIDITY_ETH=1.0
# MIN_REFERENCE_LIQUIDITY_SOL=10.0

# Heartbeat — см. README "Инфраструктурная надёжность"
# HEARTBEAT_DIR=.
# HEARTBEAT_INTERVAL_SECONDS=30

# HTTP Basic auth для веб-дашборда (wakefinder/web.py) — задайте ОБЕ, иначе
# дашборд отдаётся без аутентификации (с громким warning при старте). См.
# README "Наблюдаемость".
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=change-me

# Снайпинг новых пар (wakefinder/chains/eth/snipe.py) — см. README
# "Memecoin-снайпинг" и configs/eth-snipe.toml. Принципиально более
# рискованная стратегия — держите SNIPE_SIZE_PCT маленьким.
# SNIPE_SIZE_PCT=1.0
# SNIPE_TEST_AMOUNT_ETH=0.01
# SNIPE_MIN_LIQUIDITY_WETH=1.0
# SNIPE_TRAILING_STOP_PCT=30.0
# Доп. быстрый триггер выхода — обвал на N%+ МЕЖДУ ДВУМЯ последними
# проверками (не кумулятивно от пика, см. README "Momentum-сигналы"). Пусто
# по умолчанию = выключено.
# SNIPE_MOMENTUM_REVERSAL_PCT=20.0
# On-chain momentum-подтверждение ВХОДА — ждём min_buys подтверждающих
# свопов/подписей перед покупкой (см. README "Momentum-сигналы").
# ДОБАВЛЯЕТ задержку входа (RPC-раунд-трип) — по умолчанию выключено.
# SNIPE_MOMENTUM_CONFIRMATION=false
# SNIPE_MOMENTUM_MIN_BUYS=2

# Репутация деплойера пула через Etherscan (тот же ключ, что у CLI-команды
# discover) — отсеивает деплойеров-"однодневок" перед снайп-входом (см.
# README "Momentum-сигналы"). Пусто = проверка пропускается.
# ETHERSCAN_API_KEY=
# SNIPE_DEPLOYER_REPUTATION_CHECK=false
# SNIPE_DEPLOYER_MIN_TX_COUNT=10
# SNIPE_TRAILING_STOP_CHECK_INTERVAL_SECONDS=15
# SNIPE_MAX_CONCURRENT_POSITIONS=3
# SNIPE_ROUND_TRIP_CHECK=true                       # honeypot round-trip симуляция перед входом, см. README
# Backrun-снайпинг (chains/eth/liquidity_watcher.py) — реагирует на PENDING
# addLiquidityETH создателя пары и покупает в ТОМ ЖЕ блоке через Flashbots,
# вместо дефолтного пути (ждать смайненный PairCreated). См. README
# "Backrun-снайпинг". Выключено по умолчанию — новее и меньше проверено в
# бою, чем остальные стратегии; используйте configs/eth-snipe-backrun.toml.
# SNIPE_BACKRUN_MODE=false

# Снайпинг новых SPL-минтов на Solana (wakefinder/chains/solana/snipe.py) —
# см. README "Снайпинг на Solana" и configs/solana-snipe.toml.
# SNIPE_SIZE_PCT/SNIPE_TRAILING_STOP_PCT/_CHECK_INTERVAL_SECONDS/
# _MAX_CONCURRENT_POSITIONS выше — общие с ETH-снайпингом.
# SOLANA_SNIPE_TEST_AMOUNT_SOL=0.05
# SOLANA_SNIPE_MIN_LIQUIDITY_SOL=1.0

# Копитрейдинг (wakefinder/chains/{eth,solana}/copytrade.py) — отдельная
# стратегия от арбитража, см. README "Копитрейдинг".
# COPYTRADE_SIZE_PCT=2                              # % НАШЕГО баланса на вход, не сумма кита
# COPYTRADE_STOP_LOSS_PCT=20
# COPYTRADE_STOP_LOSS_CHECK_INTERVAL_SECONDS=60
# COPYTRADE_MIN_CONSENSUS_WALLETS=2                 # сколько разных китов должны сойтись на токене
# COPYTRADE_CONSENSUS_WINDOW_SECONDS=120
# COPYTRADE_POSITIONS_FILE=positions.json
# SOLANA_COPYTRADE_POSITIONS_FILE=positions_solana.json
# COPYTRADE_MAX_TOTAL_EXPOSURE_PCT=20               # кэп на СУММУ всех открытых позиций сразу, не одну сделку

# Наблюдаемость
# TRADE_LOG_FILE=trades.jsonl
# PNL_LEDGER_FILE=pnl_ledger.jsonl                  # леджер ЗАКРЫТЫХ сделок — см. README "История PnL"
# TELEGRAM_BOT_TOKEN=                               # пусто = алерты выключены
# TELEGRAM_CHAT_ID=

# Telegram MiniApp (wakefinder/telegram_auth.py, /telegram в web.py) — см.
# README "Telegram MiniApp". TELEGRAM_BOT_TOKEN выше используется и для
# проверки подписи initData, не только для алертов.
# TELEGRAM_ALLOWED_USER_ID=                         # числовой Telegram user_id владельца; пусто = MiniApp отклоняет всё

# Живой конфиг (wakefinder/live_config.py) — см. README "Живой конфиг".
# Дефолт ОБЩИЙ на все процессы — задайте разные live_config_file в разных
# TOML-профилях, если запускаете несколько стратегий одновременно (то же
# допущение, что и у kill_switch_file).
# LIVE_CONFIG_FILE=live_config.json
# LIVE_CONFIG_CHECK_INTERVAL_SECONDS=10

# История цены открытых позиций для графиков на дашборде
# (wakefinder/common/price_history.py) — см. README "Живые графики позиций".
# PRICE_HISTORY_FILE=price_history.jsonl

# Сканер кандидатов в watchlist (wakefinder/wallet_scanner.py) — см. README
# "Наблюдаемость". Бесплатный ключ на etherscan.io/apis; пусто = фильтр по
# активности кошелька пропускается (не ошибка).
# ETHERSCAN_API_KEY=
