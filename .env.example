# Ethereum
# Обязательны оба; у провайдеров несовместимые схемы путей WS<->HTTP, поэтому
# один URL никогда не выводится из другого. HTTP URL обязан поддерживать
# eth_getRawTransactionByHash.
ETH_RPC_WS_URL=wss://your-provider/ws
ETH_RPC_HTTP_URL=https://your-provider/http
# Отдельный горячий кошелёк ТОЛЬКО для этого бота — никогда не ваш основной
# кошелёк, держите баланс минимальным, регулярно выводите прибыль. Должен
# отличаться от ключа подписи ниже (бот отказывается стартовать, если они
# указывают на один адрес).
ETH_PRIVATE_KEY=0x...
# Ключ ТОЛЬКО для репутации у relay Flashbots — никогда не финансируется,
# никогда не тот же кошелёк, что ETH_PRIVATE_KEY выше.
FLASHBOTS_SIGNER_KEY=0x...
# Альтернатива голым ключам выше — шифрованный файл вместо plaintext, см.
# README "Безопасность". Ровно один источник на ключ (plaintext ИЛИ файл).
# python -m wakefinder.common.keystore <путь> — зашифровать интерактивно.
# ETH_PRIVATE_KEY_FILE=
# FLASHBOTS_SIGNER_KEY_FILE=
# SOLANA_PRIVATE_KEY_FILE=
# WALLET_KEY_PASSPHRASE=          # обязателен, если используется любой *_KEY_FILE выше

# Solana — опционально, только если запускаете этот путь.
# Отдельный горячий кошелёк ТОЛЬКО для Solana-бота — своё keyspace, физически
# не может совпадать с ETH-ключами. base58, не hex.
# SOLANA_RPC_WS_URL=wss://your-provider/ws
# SOLANA_RPC_HTTP_URL=https://your-provider/http
# SOLANA_PRIVATE_KEY=base58...
# JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1
# MAX_CAPITAL_PER_BUNDLE_SOL=0.5

# Список MEV-relay через запятую — бандл уходит параллельно во все (см.
# README "Мульти-relay отправка"). Дефолт — только Flashbots.
# ETH_RELAY_URLS=https://relay.flashbots.net

# Дополнительные WS-провайдеры через запятую (сверх ETH_RPC_WS_URL) — гонка
# за первенство в обнаружении pending-tx, первый увидевший выигрывает,
# дубликаты от остальных отбрасываются. См. README "Гонка RPC-провайдеров".
# Пусто по умолчанию = гонка выключена, поведение как с одним провайдером.
# ETH_RPC_WS_URLS=wss://second-provider/ws,wss://third-provider/ws

# Контроль риска
MAX_GAS_GWEI=50
MAX_CAPITAL_PER_BUNDLE_ETH=0.05
# KILL_SWITCH_FILE=             # пусто = дефолт killswitch.py (абсолютный путь в домашней директории, единый на все 4 процесса)
# PROFIT_SHARE_BPS=9000         # % захваченной прибыли, предлагаемый как tip за включение (0-10000)

# Портфельный circuit breaker по просадке — см. README "Портфельный риск-контроль"
# MAX_DRAWDOWN_ETH=0.5
# MAX_DRAWDOWN_SOL=5.0
# DRAWDOWN_WINDOW_SECONDS=86400
# DRAWDOWN_CHECK_INTERVAL_SECONDS=300

# Поэтапный ввод капитала — см. README "Поэтапный ввод капитала (canary)"
# CANARY_START_FRACTION=1.0     # 1.0 = выключено (сразу полный размер)
# CANARY_RAMP_TRADES=20         # сколько included-сделок до выхода на 100%

# Корректировка размера копитрейд-входа по win rate кошелька — см. README
# COPYTRADE_SIZING_MIN_TRADES=5
# COPYTRADE_SIZING_MIN_MULTIPLIER=0.25
# COPYTRADE_SIZING_MAX_MULTIPLIER=1.5

# Авто-обнаружение доп. референсных пулов на других известных DEX — см. README
# ETH_AUTO_DISCOVER_REFERENCE_POOLS=false

# Минимальная ликвидность референсного пула — защита от манипуляции ценой
# на тонком пуле (в единицах token_in, см. ponytail-заметку в simulator.py)
# MIN_REFERENCE_LIQUIDITY_ETH=1.0
# MIN_REFERENCE_LIQUIDITY_SOL=10.0

# Heartbeat — см. README "Инфраструктурная надёжность"
# HEARTBEAT_DIR=.
# HEARTBEAT_INTERVAL_SECONDS=30

# Копитрейдинг (wakefinder/chains/{eth,solana}/copytrade.py) — отдельная
# стратегия от арбитража, см. README "Копитрейдинг".
# COPYTRADE_SIZE_PCT=2                              # % НАШЕГО баланса на вход, не сумма кита
# COPYTRADE_STOP_LOSS_PCT=20
# COPYTRADE_STOP_LOSS_CHECK_INTERVAL_SECONDS=60
# COPYTRADE_MIN_CONSENSUS_WALLETS=2                 # сколько разных китов должны сойтись на токене
# COPYTRADE_CONSENSUS_WINDOW_SECONDS=120
# COPYTRADE_POSITIONS_FILE=positions.json
# SOLANA_COPYTRADE_POSITIONS_FILE=positions_solana.json
# COPYTRADE_MAX_TOTAL_EXPOSURE_PCT=20               # кэп на СУММУ всех открытых позиций сразу, не одну сделку

# Наблюдаемость
# TRADE_LOG_FILE=trades.jsonl
# TELEGRAM_BOT_TOKEN=                               # пусто = алерты выключены
# TELEGRAM_CHAT_ID=

# Сканер кандидатов в watchlist (wakefinder/wallet_scanner.py) — см. README
# "Наблюдаемость". Бесплатный ключ на etherscan.io/apis; пусто = фильтр по
# активности кошелька пропускается (не ошибка).
# ETHERSCAN_API_KEY=
