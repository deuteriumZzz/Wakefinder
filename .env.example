# Ethereum
# Both required; providers use incompatible WS<->HTTP path conventions so one
# is never derived from the other. HTTP URL must support eth_getRawTransactionByHash.
ETH_RPC_WS_URL=wss://your-provider/ws
ETH_RPC_HTTP_URL=https://your-provider/http
# Dedicated hot wallet for this bot ONLY — never your main wallet, keep the
# balance minimal, sweep profits out regularly. Must differ from the signer
# key below (the bot refuses to start if they resolve to the same address).
ETH_PRIVATE_KEY=0x...
# Flashbots relay reputation key ONLY — never funded, never the same wallet
# as ETH_PRIVATE_KEY above.
FLASHBOTS_SIGNER_KEY=0x...

# Solana (added in Phase 3)
# SOLANA_RPC_URL=
# SOLANA_PRIVATE_KEY=
# JITO_BLOCK_ENGINE_URL=

# Risk controls
MAX_GAS_GWEI=50
MAX_CAPITAL_PER_BUNDLE_ETH=0.05
# KILL_SWITCH_FILE=.kill        # touch this file to stop the bot before its next action
# PROFIT_SHARE_BPS=9000         # % of captured profit bid as inclusion tip (0-10000)
